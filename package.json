  },
  "keywords": [
    "cli",
    "weixin",
    "wechat",
    "sogou",
    "search"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianzhangg/wx-search.git"
  },
  "dependencies": {

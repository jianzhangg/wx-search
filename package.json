{
  "name": "wx-search",
  "version": "0.2.0",
  "description": "CLI for searching and reading WeChat official account (公众号) articles via Sogou WeChat search, with configurable User-Agent",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wx-search": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
